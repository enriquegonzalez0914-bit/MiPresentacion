
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MiPresentacion.MainWindow"
    Title="MiPresentacion"
    Width="500"
    Height="650"
    MinWidth="400"
    MinHeight="550"
    WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel
            Margin="30"
            Spacing="15"
            VerticalAlignment="Center">

            <TextBlock
                Text="Mi primera aplicación gráfica"
                FontSize="25"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"/>

            <TextBlock Text="Nombre:" FontWeight="Bold"/>

            <TextBox
                x:Name="txtNombre"
                Watermark="Ingrese su nombre"/>

            <TextBlock Text="Apellido:" FontWeight="Bold"/>

            <TextBox
                x:Name="txtApellido"
                Watermark="Ingrese su apellido"/>

            <TextBlock Text="Edad:" FontWeight="Bold"/>

            <TextBox
                x:Name="txtEdad"
                Watermark="Ingrese su edad"/>

            <Button
                Content="Presentarme"
                Click="BtnPresentarme_Click"
                HorizontalAlignment="Stretch"
                Margin="0,15,0,0"/>

            <Button
                Content="Limpiar"
                Click="BtnLimpiar_Click"
                HorizontalAlignment="Stretch"/>

            <Button
                Content="Cambiar saludo"
                Click="BtnCambiarSaludo_Click"
                HorizontalAlignment="Stretch"/>

            <TextBlock
                Text="Aquí aparecerá tu presentación."
                x:Name="txtResultado"
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Margin="0,20,0,10"/>

        </StackPanel>
    </ScrollViewer>

</Window>
